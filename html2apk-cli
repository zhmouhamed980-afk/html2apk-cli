# ── Terminal helpers ──────────────────────────────────────────────────────────

def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            ch2 = sys.stdin.read(1)
            if ch2 == '[':
                ch3 = sys.stdin.read(1)
                return f'\x1b[{ch3}'
            return '\x1b'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

def hide_cursor(): sys.stdout.write('\x1b[?25l'); sys.stdout.flush()
def show_cursor(): sys.stdout.write('\x1b[?25h'); sys.stdout.flush()

def redraw(lines_to_erase, new_lines):
    if lines_to_erase > 0:
        sys.stdout.write(f'\x1b[{lines_to_erase}A')
    sys.stdout.write('\x1b[J')
    sys.stdout.write('\n'.join(new_lines))
    sys.stdout.write('\n')
    sys.stdout.flush()

def prompt_input(question, default=None):
    hint = f" {clr(f'[{default}]', C.DIM)}" if default else ""
    val = input(f"  {clr('→', C.CYAN, C.BOLD)} {clr(question, C.BOLD)}{hint}: ").strip()
    return val if val else default

def permissions_selector():
    selected = [p[4] for p in PERMISSIONS]
    cursor = 0
    visible = min(len(PERMISSIONS), 14)
    scroll_top = 0

    def build_lines():
        out = []
        out.append(clr("  ┌─ Select Permissions ──────────────────────────────────────────────┐", C.CYAN, C.BOLD))
        out.append(clr("  │  ↑↓ move  SPACE toggle  A all  N none  ENTER confirm              │", C.DIM))
        out.append(clr("  └───────────────────────────────────────────────────────────────────┘", C.CYAN, C.BOLD))
        for i in range(scroll_top, min(scroll_top + visible, len(PERMISSIONS))):
            _, label, desc, _, _ = PERMISSIONS[i]
            box = clr("[✓]", C.GREEN, C.BOLD) if selected[i] else clr("[ ]", C.DIM)
            if i == cursor:
                out.append(clr(f"  ▶ {box} {label:<24}", C.CYAN, C.BOLD) + clr(desc, C.CYAN))
            else:
                out.append(f"    {box} {clr(label, C.BOLD):<24}{clr(desc, C.DIM)}")
        total = len(PERMISSIONS)
        end_idx = min(scroll_top + visible, total)
        if total > visible:
            pct = int(scroll_top / max(1, total - visible) * 100)
            out.append(clr(f"  {scroll_top+1}–{end_idx} of {total}  ({pct}%)", C.DIM))
        else:
            out.append("")
        out.append(clr(f"  ✔ {sum(selected)} permission(s) selected", C.YELLOW, C.BOLD))
        return out

    hide_cursor()
    current_lines = build_lines()
    print('\n'.join(current_lines))
    try:
        while True:
            ch = getch()
            prev_len = len(current_lines)
            if ch == '\x1b[A':
                cursor = max(0, cursor - 1)
                if cursor < scroll_top: scroll_top = cursor
            elif ch == '\x1b[B':
                cursor = min(len(PERMISSIONS) - 1, cursor + 1)
                if cursor >= scroll_top + visible: scroll_top = cursor - visible + 1
            elif ch == ' ':
                selected[cursor] = not selected[cursor]
            elif ch in ('a', 'A'):
                selected = [True] * len(PERMISSIONS)
            elif ch in ('n', 'N'):
                selected = [False] * len(PERMISSIONS)
            elif ch in ('\r', '\n'):
                break
            elif ch in ('q', '\x1b'):
                break
            current_lines = build_lines()
            redraw(prev_len, current_lines)
    finally:
        show_cursor()

    return [PERMISSIONS[i][3] for i, s in enumerate(selected) if s]

# ── Helpers ───────────────────────────────────────────────────────────────────

def run(cmd, cwd=None, env=None, silent=False):
    try:
        process = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            shell=True, text=True, cwd=cwd, env=env
        )
        output = []
        for line in process.stdout:
            if not silent:
                print(line, end='')
            output.append(line)
        process.wait()
        return process.returncode == 0, ''.join(output)
    except Exception as e:
        return False, str(e)

def find_sdk():
    candidates = [
        Path.home() / "Android" / "Sdk",
        Path.home() / "android-sdk",
        Path("/usr/lib/android-sdk"),
        Path("/opt/android-sdk"),
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    success, out = run("which adb", silent=True)
    if success and out.strip():
        return str(Path(out.strip()).parent.parent)
    return None

def find_cap_bin(project_path):
    cap = project_path / "node_modules" / ".bin" / "cap"
    if cap.exists():
        return str(cap)
    return "npx cap"

def inject_safe_area(dist_path):
    index = dist_path / "index.html"
    if not index.exists():
        return
    content = index.read_text(encoding='utf-8')

    safe_area_css = (
        "\n  <style>\n"
        "    body {\n"
        "      padding-top: env(safe-area-inset-top, 0px) !important;\n"
        "      -webkit-tap-highlight-color: transparent;\n"
        "    }\n"
        "  </style>"
    )

    viewport = '<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">'

    if 'viewport' in content:
        content = re.sub(r'<meta[^>]*name=["\']viewport["\'][^>]*>', viewport, content)
    else:
        content = content.replace('<head>', f'<head>\n  {viewport}')

    if 'safe-area-inset-top' not in content:
        content = content.replace('</head>', f'{safe_area_css}\n</head>')

    index.write_text(content, encoding='utf-8')
    ok("Status bar safe area fix injected into index.html")

def write_network_security_config(android_path):
    xml_dir = android_path / "app" / "src" / "main" / "res" / "xml"
    xml_dir.mkdir(parents=True, exist_ok=True)
    (xml_dir / "network_security_config.xml").write_text(
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<network-security-config>\n'
        '  <base-config cleartextTrafficPermitted="true">\n'
        '    <trust-anchors>\n'
        '      <certificates src="system" />\n'
        '    </trust-anchors>\n'
        '  </base-config>\n'
        '</network-security-config>\n',
        encoding='utf-8'
    )
    ok("network_security_config.xml created (HTTP cleartext allowed)")

def write_android_manifest(android_path, app_id, permissions):
    manifest_path = android_path / "app" / "src" / "main" / "AndroidManifest.xml"
    perms_xml = '\n    '.join(
        f'<uses-permission android:name="{p}" />'
        for p in sorted(set(permissions))
    )
    manifest_path.write_text(
        f"""<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    {perms_xml}

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name="{app_id}.MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
""",
        encoding='utf-8'
    )
    ok("AndroidManifest.xml written")

def write_capacitor_config(project_path, app_id, app_name):
    (project_path / "capacitor.config.ts").write_text(
        f"""import {{ CapacitorConfig }} from '@capacitor/cli';

const config: CapacitorConfig = {{
  appId: '{app_id}',
  appName: '{app_name}',
  webDir: 'dist',
  android: {{
    allowMixedContent: true,
  }},
  plugins: {{
    StatusBar: {{
      overlaysWebView: false,
      backgroundColor: '#080808',
    }},
  }},
  server: {{
    cleartext: true,
    androidScheme: 'http',
  }},
}};

export default config;
""",
        encoding='utf-8'
    )
    ok("capacitor.config.ts written")

def copy_icon(icon_path, android_path):
    for density in ['mipmap-mdpi', 'mipmap-hdpi', 'mipmap-xhdpi', 'mipmap-xxhdpi', 'mipmap-xxxhdpi']:
        dest = android_path / "app" / "src" / "main" / "res" / density
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copy2(icon_path, dest / "ic_launcher.png")
        shutil.copy2(icon_path, dest / "ic_launcher_round.png")
    ok("Icon copied to all mipmap densities")

# ── Wizard ────────────────────────────────────────────────────────────────────

def run_wizard(source_path):
    print(clr("\n  ╔══════════════════════════════════════════╗", C.CYAN, C.BOLD))
    print(clr("  ║    html2apk-cli  (Capacitor Edition)     ║", C.CYAN, C.BOLD))
    print(clr("  ╚══════════════════════════════════════════╝\n", C.CYAN, C.BOLD))

    folder_name = source_path.name.replace("-", " ").replace("_", " ").title()
    safe_name   = re.sub(r'[^a-z0-9]', '', source_path.name.lower()) or "app"
    pkg_default = f"com.example.{safe_name}"

    app_name = prompt_input("App name",   default=folder_name)
    app_id   = prompt_input("Package ID (letters and dots only)", default=pkg_default)
    version  = prompt_input("Version",    default="1.0.0")

    print(f"\n  {clr('→', C.CYAN, C.BOLD)} {clr('Icon path (PNG)', C.BOLD)} {clr('[leave blank to skip]', C.DIM)}: ", end="", flush=True)
    icon_raw  = input().strip()
    icon_path = Path(icon_raw).resolve() if icon_raw else None
    if icon_path and not icon_path.exists():
        warn(f"Icon '{icon_raw}' not found — skipping.")
        icon_path = None

    print(f"\n  {clr('⚙  Select permissions:', C.BOLD, C.YELLOW)}\n")
    chosen_perms = permissions_selector()

    print(f"\n  {clr('Build type:', C.BOLD)}")
    print(f"    {clr('[1]', C.CYAN)} Debug  {clr('(default)', C.DIM)}")
    print(f"    {clr('[2]', C.CYAN)} Release")
    bt = input(f"\n  {clr('→', C.CYAN, C.BOLD)} Choice [1]: ").strip()

    return {
        "name":    app_name,
        "id":      app_id,
        "version": version,
        "icon":    icon_path,
        "release": (bt == "2"),
        "perms":   chosen_perms,
    }

# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="html2apk-cli (Capacitor): Convert web projects to Android APK.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python3 html2apk.py ./my-app
  python3 html2apk.py ./my-app --no-wizard --name "My App" --id com.me.app
        """
    )
    parser.add_argument("source",       help="Path to the web project folder")
    parser.add_argument("--output",     default="dist-apk")
    parser.add_argument("--sdk",        help="Android SDK path (auto-detected if not set)")
    parser.add_argument("--java",       help="JAVA_HOME path")
    parser.add_argument("--skip-build", action="store_true")
    parser.add_argument("--no-wizard",  action="store_true")
    parser.add_argument("--name",       default=None)
    parser.add_argument("--id",         default=None)
    parser.add_argument("--version",    default="1.0.0")
    parser.add_argument("--icon",       default=None)
    parser.add_argument("--release",    action="store_true")

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(0)

    args        = parser.parse_args()
    source_path = Path(args.source).resolve()
    if not source_path.is_dir():
        err(f"'{args.source}' is not a directory.")

    if args.no_wizard:
        safe_name = re.sub(r'[^a-z0-9]', '', source_path.name.lower()) or "app"
        config = {
            "name":    args.name    or source_path.name,
            "id":      args.id      or f"com.example.{safe_name}",
            "version": args.version,
            "icon":    Path(args.icon).resolve() if args.icon else None,
            "release": args.release,
            "perms":   [],
        }
    else:
        config = run_wizard(source_path)

    if not re.match(r'^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z][a-zA-Z0-9_]*)+$', config["id"]):
        err(f"Invalid package ID '{config['id']}'. Example: com.sky.novels")

    print(clr("\n  ─────────────────────────────────────────", C.DIM))
    print(clr("  Build Summary", C.BOLD, C.HEADER))
    print(clr("  ─────────────────────────────────────────", C.DIM))
    print(f"  App Name : {clr(config['name'], C.BOLD)}")
    print(f"  Package  : {clr(config['id'], C.BOLD)}")
    print(f"  Version  : {clr(config['version'], C.BOLD)}")
    print(f"  Icon     : {clr(str(config['icon']) if config['icon'] else 'Default', C.BOLD)}")
    print(f"  Build    : {clr('Release' if config['release'] else 'Debug', C.BOLD)}")
    print(f"  Engine   : {clr('Capacitor + Gradle', C.CYAN, C.BOLD)}")
    print(clr("  ─────────────────────────────────────────\n", C.DIM))

    confirm = input(f"  {clr('→ Start build? [Y/n]: ', C.CYAN, C.BOLD)}").strip().lower()
    if confirm == 'n':
        print("  Cancelled.")
        sys.exit(0)
    print()

    # ── Environment ──
    env = os.environ.copy()

    sdk_path = args.sdk or find_sdk()
    if sdk_path:
        env["ANDROID_HOME"]     = sdk_path
        env["ANDROID_SDK_ROOT"] = sdk_path
        env["PATH"] += f":{sdk_path}/platform-tools:{sdk_path}/cmdline-tools/latest/bin:{sdk_path}/tools/bin"
        ok(f"Android SDK: {sdk_path}")
    else:
        warn("Android SDK not found — build may fail.")

    if args.java:
        env["JAVA_HOME"] = args.java
        env["PATH"] = f"{os.path.join(args.java, 'bin')}:{env['PATH']}"
    elif "JAVA_HOME" not in env:
        for java in ["/usr/lib/jvm/java-17-openjdk-amd64", "/usr/lib/jvm/java-11-openjdk-amd64"]:
            if os.path.exists(java):
                env["JAVA_HOME"] = java
                env["PATH"]      = f"{java}/bin:{env['PATH']}"
                ok(f"Java: {java}")
                break

    # ── 1. npm install ──
    pkg_json = source_path / "package.json"
    if pkg_json.exists():
        log("Installing dependencies...", C.CYAN)
        success, _ = run("npm install", cwd=source_path, env=env)
        if not success:
            err("npm install failed.")

        if not (source_path / "node_modules" / "@capacitor" / "core").exists():
            log("Installing Capacitor...", C.CYAN)
            success, _ = run(
                "npm install @capacitor/core @capacitor/cli @capacitor/android",
                cwd=source_path, env=env
            )
            if not success:
                err("Failed to install Capacitor.")
            ok("Capacitor installed")

    # ── 2. Write capacitor.config.ts ──
    log("Writing Capacitor config...", C.CYAN)
    write_capacitor_config(source_path, config["id"], config["name"])

    # ── 3. npm run build ──
    if pkg_json.exists() and not args.skip_build:
        try:
            with open(pkg_json) as f:
                pkg = json.load(f)
            if "scripts" in pkg and "build" in pkg["scripts"]:
                log("Building web assets...", C.CYAN)
                success, _ = run("npm run build", cwd=source_path, env=env)
                if not success:
                    err("npm run build failed.")
        except Exception as e:
            warn(f"package.json error: {e}")

    # Find dist
    dist_path = None
    for d in ["dist", "build", "out", "public", "output"]:
        c = source_path / d
        if c.is_dir() and (c / "index.html").exists():
            dist_path = c
            ok(f"Web assets: {d}/")
            break
    if dist_path is None:
        if (source_path / "index.html").exists():
            dist_path = source_path
        else:
            err("No index.html found.")

    # ── 4. Inject safe area ──
    log("Injecting status bar / safe area fix...", C.CYAN)
    inject_safe_area(dist_path)

    # ── 5. Add Android platform ──
    cap_bin      = find_cap_bin(source_path)
    android_path = source_path / "android"

    if android_path.exists():
        log("Removing old Android platform...", C.CYAN)
        shutil.rmtree(android_path)

    log("Adding Android platform via Capacitor...", C.CYAN)
    success, _ = run(f"{cap_bin} add android", cwd=source_path, env=env)
    if not success:
        err("Failed to add Android platform.")

    # ── 6. Sync ──
    log("Syncing assets...", C.CYAN)
    run(f"{cap_bin} sync android", cwd=source_path, env=env)

    # ── 7. Network security (HTTP cleartext) ──
    log("Applying HTTP cleartext fix...", C.CYAN)
    write_network_security_config(android_path)

    # ── 8. AndroidManifest ──
    log("Writing AndroidManifest.xml...", C.CYAN)
    all_perms = [p for group in config["perms"] for p in group]
    write_android_manifest(android_path, config["id"], all_perms)

    # ── 9. Icon ──
    if config["icon"] and Path(config["icon"]).exists():
        log("Copying icon...", C.CYAN)
        copy_icon(Path(config["icon"]), android_path)

    # ── 10. local.properties ──
    if sdk_path:
        (android_path / "local.properties").write_text(
            f"sdk.dir={sdk_path}\n", encoding='utf-8'
        )
        run(f"chmod -R 777 {sdk_path}", silent=True)
        ok(f"local.properties → {sdk_path}")

    # ── 11. Build APK ──
    gradlew    = android_path / "gradlew"
    build_type = "assembleRelease" if config["release"] else "assembleDebug"

    if not gradlew.exists():
        err("gradlew not found.")

    run(f"chmod +x {gradlew}", silent=True)
    log(f"Running Gradle ({build_type})...", C.CYAN)
    success, _ = run(f"./gradlew {build_type}", cwd=android_path, env=env)
    if not success:
        err("Gradle build failed.")

    # ── 12. Copy APK ──
    mode    = "release" if config["release"] else "debug"
    apk_dir = android_path / "app" / "build" / "outputs" / "apk" / mode
    apks    = list(apk_dir.glob("*.apk"))
    if not apks:
        err("APK not found after build.")

    output_path = Path(args.output).resolve()
    output_path.mkdir(parents=True, exist_ok=True)
    safe_name  = re.sub(r'[^\w]', '_', config["name"])
    final_name = f"{safe_name}_{mode}.apk"
    shutil.copy2(apks[0], output_path / final_name)

    print(clr("\n  ╔══════════════════════════════════════════╗", C.GREEN, C.BOLD))
    print(clr("  ║          ✅  Build Successful!            ║", C.GREEN, C.BOLD))
    print(clr("  ╚══════════════════════════════════════════╝", C.GREEN, C.BOLD))
    print(f"\n  {clr('APK:', C.BOLD)} {clr(str(output_path / final_name), C.CYAN)}\n")


if __name__ == "__main__":
    main()
