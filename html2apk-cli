    YELLOW  = '\033[93m'
    RED     = '\033[91m'
    RESET   = '\033[0m'
    BOLD    = '\033[1m'
    DIM     = '\033[2m'

def clr(text, *colors):
    return ''.join(colors) + str(text) + C.RESET

def log(msg, color=C.BLUE):  print(clr(f"[*] {msg}", C.BOLD, color))
def ok(msg):                  print(clr(f"[✓] {msg}", C.BOLD, C.GREEN))
def warn(msg):                print(clr(f"[!] {msg}", C.BOLD, C.YELLOW))
def err(msg):                 print(clr(f"[✗] {msg}", C.BOLD, C.RED)); sys.exit(1)

