#!/usr/bin/env python3
"""
html2apk-cli (Capacitor Edition)
Converts React/Vite or plain HTML web projects to Android APK.
Handles automatically: HTTP cleartext, status bar, safe area, icon, permissions.
"""

import argparse
import os
import shutil
import subprocess
import sys
import json
import re
import tty
import termios
from pathlib import Path

# ── Colors ───────────────────────────────────────────────────────────────────

class C:
    HEADER  = '\033[95m'
    BLUE    = '\033[94m'
    CYAN    = '\033[96m'
    GREEN   = '\033[92m'
    YELLOW  = '\033[93m'
    RED     = '\033[91m'
    RESET   = '\033[0m'
    BOLD    = '\033[1m'
    DIM     = '\033[2m'

def clr(text, *colors):
    return ''.join(colors) + str(text) + C.RESET

def log(msg, color=C.BLUE):  print(clr(f"[*] {msg}", C.BOLD, color))
def ok(msg):                  print(clr(f"[✓] {msg}", C.BOLD, C.GREEN))
def warn(msg):                print(clr(f"[!] {msg}", C.BOLD, C.YELLOW))
def err(msg):                 print(clr(f"[✗] {msg}", C.BOLD, C.RED)); sys.exit(1)

